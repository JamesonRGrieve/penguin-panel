#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Penguin pre-commit: the light checks, on staged files only (whitespace, php -l,
# Pint). PHPStan and PHPUnit run on the build runner, never on the desktop.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
git diff --cached --check
mapfile -t phpfiles < <(git diff --cached --name-only --diff-filter=ACM -- '*.php')
((${#phpfiles[@]})) || exit 0
for f in "${phpfiles[@]}"; do php -l "$f" >/dev/null; done
if [[ ! -x vendor/bin/pint ]]; then
  echo "pre-commit: vendor/bin/pint missing; run composer install"; exit 1
fi
vendor/bin/pint --test "${phpfiles[@]}"
